# --- secrets: NEVER commit ---
.env
*.key

# --- environments ---
.venv/
venv/
env/

# --- build artifacts: rebuild with `python ingest.py` ---
data/
*.faiss
*.pkl

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- editors / os ---
.vscode/
.idea/
.DS_Store

# --- demo media: MUST stay tracked ---
# Explicit, because a .gitignore rule silently dropped the 430MB index from a
# Hugging Face upload once (huggingface_hub feeds .gitignore to the preupload
# API). These negations mean a future broad rule like *.mp4 cannot quietly eat
# the README demo. Verify with: git check-ignore -v assets/demo.gif
!assets/*.gif
!assets/*.mp4
!assets/*.png

# --- local scratch ---
*.log
scratch/

# --- private working notes (kept local, not published) ---
CLAUDE.md
