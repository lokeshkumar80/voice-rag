# Copy to .env and fill in your key.  cp .env.example .env
# Precedence: shell env > .env > default in config.py

# --- required ---
# Get one at https://dashboard.sarvam.ai (free signup credits)
SARVAM_API_KEY=

# --- language / dataset ---
# NOTE: the variable is LANG_CODE, not LANG. LANG is the system locale var.
# There is no "en" code -- English lives inside each language's parquet as the
# English_passages field. For English, keep LANG_CODE=hi and switch PASSAGE_FIELD.
LANG_CODE=hi
PASSAGE_FIELD=Translated_passages
SARVAM_LANG=hi-IN
SPLIT=validation
MAX_ROWS=500                 # 500 = smoke build; 10000 = real corpus

# --- hardware ---
DEVICE=cuda                  # "cpu" to fall back
INDEX_TYPE=hnsw              # hnsw (ANN) | flat (exact)
EMBED_BATCH=64
EMBED_MAX_SEQ=512            # keep: 8192 default OOMs an 8GB card

# --- chunking ---
CHUNK_STRATEGY=sentence      # fixed | sentence | recursive | semantic (measured winner)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_CHARS=80           # merges degenerate fragments; do not set to 0

# --- retrieval ---
HYBRID_ALPHA=0.9             # measured optimum; see eval.py --sweep
TOP_K=5
USE_RERANK=false             # true costs ~332ms P50 -> breaks the 200ms budget

# --- guardrails ---
MIN_DENSE_SCORE=0.58         # calibrated on HARD negatives; see scripts/calibrate_guardrail.py
MIN_GROUNDING_OVERLAP=0.35

# --- generation ---
GENERATION_MODE=extractive   # extractive (no LLM, ~0ms) | llm (Sarvam chat)
